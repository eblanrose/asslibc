[ ca ]
default_ca = CA_default
[ CA_default ]
dir              = .
database         = index.txt
new_certs_dir    = .
certificate      = ca.crt
private_key      = ca.key
serial           = serial
crlnumber        = crlnumber
default_md       = sha256
default_crl_days = 30
policy           = policy_any
[ policy_any ]
commonName = supplied
